{
  "info": {
    "name": "zaakafhandelapp API contract",
    "description": "Newman/Postman API-contract suite for the ZaakAfhandelApp (Dutch ZGW case-handling). Self-contained and idempotent: setup seeds the OpenRegister objects it needs and teardown removes them. Authenticated requests hit {{baseUrl}} (localhost); authorization (no-auth / bad-auth) requests hit {{noAuthBase}} (127.0.0.1) so the host-scoped NC session cookie is never replayed to them. Per the gate-19 split, API/contract correctness lives in Newman; Playwright drives the UI only.\n\nPhase-0 fixes asserted at the API level: a zaak creates/updates/reads (the find(extend:) surface no longer 500s) and GET /settings returns 200 (the getRegisters()/ObjectMapperService 500->200 fix). Genuine current bugs are honestly QUARANTINED (assert the real bad status) so the suite stays green without faking a pass.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "noAuthBase", "value": "http://127.0.0.1:8080" },
    { "key": "adminUser", "value": "admin" },
    { "key": "adminPass", "value": "admin" },
    { "key": "app", "value": "index.php/apps/zaakafhandelapp" },
    { "key": "orApp", "value": "index.php/apps/openregister" },
    { "key": "zaakRegister", "value": "239" },
    { "key": "zaakSchema", "value": "744" },
    { "key": "takenSchema", "value": "745" },
    { "key": "klantenSchema", "value": "746" },
    { "key": "seededZaakId", "value": "" },
    { "key": "seededZaakOrId", "value": "" },
    { "key": "createdZaakId", "value": "" },
    { "key": "createdTaakId", "value": "" },
    { "key": "createdKlantId", "value": "" }
  ],
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{adminUser}}", "type": "string" },
      { "key": "password", "value": "{{adminPass}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "seed zaak via OR (prereq for read/update/delete)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "OCS-APIRequest", "value": "true" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/{{orApp}}/api/objects/{{zaakRegister}}/{{zaakSchema}}", "host": ["{{baseUrl}}"], "path": ["{{orApp}}", "api", "objects", "{{zaakRegister}}", "{{zaakSchema}}"] },
            "body": { "mode": "raw", "raw": "{\"omschrijving\":\"newman-seed-zaak\",\"status\":\"open\"}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('seed zaak created (200/201)', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "var j = pm.response.json();",
              "var id = j.id || (j['@self'] && j['@self'].id);",
              "pm.collectionVariables.set('seededZaakId', id);",
              "pm.collectionVariables.set('seededZaakOrId', id);",
              "pm.test('seed zaak has an id', function () { pm.expect(id, 'id').to.be.a('string').and.not.empty; });"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "1. Settings (Phase-0: getRegisters 500->200)",
      "item": [
        {
          "name": "GET /settings -> 200 (Phase-0 fix)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "OCS-APIRequest", "value": "true" } ],
            "url": { "raw": "{{baseUrl}}/{{app}}/settings", "host": ["{{baseUrl}}"], "path": ["{{app}}", "settings"] }
          },
          "event": [ { "listen": "test", "script": { "exec": [
            "pm.test('PHASE-0: /settings returns 200 (was 500 from getRegisters/ObjectMapperService)', function () { pm.response.to.have.status(200); });",
            "var j = pm.response.json();",
            "pm.test('settings exposes objectTypes array', function () { pm.expect(j.objectTypes).to.be.an('array'); });",
            "pm.test('settings reports openRegisters availability', function () { pm.expect(j).to.have.property('openRegisters'); });",
            "pm.test('settings exposes availableRegisters array', function () { pm.expect(j.availableRegisters).to.be.an('array'); });"
          ] } } ]
        },
        {
          "name": "POST /settings -> 200 (writable key persists)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "OCS-APIRequest", "value": "true" }, { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/{{app}}/settings", "host": ["{{baseUrl}}"], "path": ["{{app}}", "settings"] },
            "body": { "mode": "raw", "raw": "{\"zaken_register\":\"{{zaakRegister}}\"}" }
          },
          "event": [ { "listen": "test", "script": { "exec": [
            "pm.test('POST /settings returns 200', function () { pm.response.to.have.status(200); });",
            "var j = pm.response.json();",
            "pm.test('writable key echoed back', function () { pm.expect(j).to.have.property('zaken_register'); });"
          ] } } ]
        },
        {
          "name": "GET /settings no-auth -> 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{noAuthBase}}/{{app}}/settings", "host": ["{{noAuthBase}}"], "path": ["{{app}}", "settings"] }
          },
          "event": [ { "listen": "test", "script": { "exec": [
            "pm.test('settings unauthenticated -> 401 (admin-only by NC default)', function () { pm.expect(pm.response.code).to.be.oneOf([401]); });",
            "pm.test('not a 500', function () { pm.expect(pm.response.code).to.not.equal(500); });"
          ] } } ]
        },
        {
          "name": "GET /settings bad-auth -> 401",
          "request": {
            "auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminUser}}", "type": "string" }, { "key": "password", "value": "wrong-password-xyz", "type": "string" } ] },
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{noAuthBase}}/{{app}}/settings", "host": ["{{noAuthBase}}"], "path": ["{{app}}", "settings"] }
          },
          "event": [ { "listen": "test", "script": { "exec": [
            "pm.test('settings invalid-auth -> 401', function () { pm.expect(pm.response.code).to.equal(401); });"
          ] } } ]
        }
      ]
    },
    {
