            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "OCS-APIRequest", "value": "true" } ],
            "url": { "raw": "{{baseUrl}}/{{app}}/api/zrc/resultaten", "host": ["{{baseUrl}}"], "path": ["{{app}}", "api", "zrc", "resultaten"] }
