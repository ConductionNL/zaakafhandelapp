{
  "name": "zaakafhandelapp",
  "version": "1.0.0",
  "license": "EUPL-1.2",
  "engines": {
    "node": "^20.0.0",
    "npm": "^10.0.0"
  },
  "scripts": {
    "test:l10n": "node tests/l10n/check-l10n.js",
    "test:l10n:write": "node tests/l10n/check-l10n.js --write",
    "postinstall": "find node_modules -path '*/vue-demi/scripts/postinstall.js' -execdir node {} \\; 2>/dev/null || true",
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "lint": "eslint src",
    "lint-fix": "npm run lint -- --fix",
    "test": "jest --silent",
    "test-coverage": "jest --silent --coverage",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.include=src/** --coverage.reportsDirectory=coverage-vitest",
    "test:coverage-ratchet": "npm run test:coverage && bash tests/coverage-ratchet.sh vitest coverage-vitest/coverage-summary.json",
    "check:manifest": "node tests/validate-manifest.js",
    "check:specs": "npm run check:manifest",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:docs": "playwright test --project docs-capture",
    "test:e2e:install": "playwright install chromium",
    "stylelint": "stylelint \"src/**/*.{vue,scss,css}\"",
    "format": "prettier --check \"**/*.{js,ts,vue,css,scss}\"",
    "format:fix": "prettier --write \"**/*.{js,ts,vue,css,scss}\""
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@conduction/nextcloud-vue": "2.2.0-vue3.16",
    "@nextcloud/auth": "^2.5.0",
    "@nextcloud/axios": "~2.5.2",
    "@nextcloud/capabilities": "^1.2.1",
    "@nextcloud/dialogs": "^7.4.1",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.9.0",
    "@vueuse/core": "^14.3.0",
    "axe-core": "^4.10.0",
    "dexie": "^4.0.8",
    "dompurify": "^3.4.12",
    "gridstack": "^12.6.0",
    "lodash": "^4.17.21",
    "marked": "^12.0.0",
    "path-browserify": "^1.0.1",
    "pinia": "^2.3.0",
    "terser-webpack-plugin": "^5.6.1",
    "vue": "^3.5.18",
    "vue-material-design-icons": "^5.3.0",
    "vue-router": "^4.6.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/config-helpers": "^0.4.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^8.4.1",
    "@nextcloud/eslint-plugin": "^2.2.1",
    "@nextcloud/prettier-config": "^1.2.0",
    "@nextcloud/stylelint-config": "^2.4.0",
    "@nextcloud/webpack-vue-config": "^7.0.2",
    "@pinia/testing": "^0.1.3",
    "@playwright/test": "^1.49.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.12",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/compiler-sfc": "^3.5.18",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/vue3-jest": "^29.2.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-exports": "^1.0.0-beta.5",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^46.10.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-vue": "^9.33.0",
    "eslint-webpack-plugin": "^4.2.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "node-polyfill-webpack-plugin": "^3.0.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.6",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.8",
    "style-loader": "^4.0.0",
    "stylelint": "^15.11.0",
    "stylelint-config-recommended-scss": "^13.1.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-webpack-plugin": "^5.0.1",
    "ts-jest": "^29.2.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "vitest": "^1.6.1",
    "vue-eslint-parser": "^9.4.3",
    "vue-loader": "^17.4.2",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  },
  "overrides": {
    "minimatch": "^3.1.2"
  },
  "prettier": "@nextcloud/prettier-config"
}
