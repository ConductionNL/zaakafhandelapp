# ZaakAfhandelApp — Conduction PHPStan config.
#
# The shared base is the single source of truth. Everything here is either the
# app's own tracked debt or an ignore naming a symbol that exists in no other
# fleet app. Anything you are tempted to add that another app would also need
# belongs in the base, not here.
includes:
    - vendor/conduction/hydra-gates/quality-config/phpstan-base.neon
    # Per-app tracked lint debt (auto-generated via `phpstan --generate-baseline`).
    - phpstan-baseline.neon

parameters:
    # ── TEMPORARY DEVIATION — remove once the base marks its optional paths ──
    # This app is the only one in the fleet on PHPStan 2.x (2.2.8; the other 17 are
    # on 1.12.x). PHPStan 2 VALIDATES excludePaths and aborts the whole run when an
    # entry does not exist:
    #   Path "/app/vendor-bin" is neither a directory, nor a file path, nor a
    #   fnmatch pattern. If the excluded path can sometimes exist, append (?)
    # Neither `vendor-bin` nor `lib/Resources/template` exists here, and the base
    # declares both without the `(?)` optional marker — so inheriting the base list
    # unchanged makes phpstan exit before analysing anything. The `!` re-declares
    # the list rather than appending to it. Drop this block and the `!` as soon as
    # the base marks those two paths optional.
    excludePaths!:
        analyseAndScan:
            - vendor
            - vendor-bin (?)
            - lib/Resources/template (?)
        analyse: []

    # App-specific only. The base already sets level, paths, bootstrapFiles,
    # scanDirectories and every fleet-wide ignore.
    ignoreErrors:
        # @SuppressWarnings(PHPMD.*) is a PHPMD-specific PHPDoc annotation; PHPStan cannot
        # parse the dotted-identifier argument syntax and emits phpDoc.parseError.
        # The annotation is intentional and correct for PHPMD; silence the PHPStan noise.
        -
            message: '#PHPDoc tag @SuppressWarnings has invalid value#'
            identifier: phpDoc.parseError
